# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
.venv/
venv/
ENV/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data directories (keep directory structure with .gitkeep but ignore large files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Reports / Figures generated (optional, exclude large exports)
reports/figures/*
!reports/figures/.gitkeep

# Saved model artifacts
models/*
!models/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets / Environment variables
.env
*.env
config/*.secret.yaml
config/*.secret.json
